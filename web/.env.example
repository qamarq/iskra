DATABASE_URL=postgres://iskra:iskra@localhost:5433/iskra
CRON_SECRET=

# Model językowy: Anthropic (domyślnie, gdy jest klucz) albo API zgodne z OpenAI
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_DETECT_MODEL=claude-sonnet-5-5

# OpenAI: embeddingi (wyszukiwanie po znaczeniu, duplikaty) i opcjonalnie model językowy
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
OPENAI_DETECT_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
